# PostgreSQL. Apply sql/schema.sql once (and again after updates; it is idempotent).
DATABASE_URL="postgresql://user:pass@host/db"
# Dedicated devnet RPC, not the public endpoint.
RPC_URL="https://devnet.helius-rpc.com/?api-key=..."
CLUSTER="devnet"
# Keeper (the reservations' delegate). Render: the JSON array. Local: a file path.
KEEPER_KEYPAIR_JSON="[1,2,3,...]"
# KEEPER_KEYPAIR="./keeper.json"
# On-chain Config admin. Only needed to activate merchant codes (register_merchant).
ADMIN_KEYPAIR_JSON="[1,2,3,...]"
# ADMIN_KEYPAIR="./admin.json"
PIN_PEPPER="long-random-secret"
ENROLL_TOKEN="dev-only-secret"
# Browser origins allowed to call /meta, /enroll/*, /merchant/*. Comma-separated.
CORS_ORIGINS="https://pat-sol.vercel.app"
# Optional: tokens offered in the app, "MINT:SYMBOL,MINT:SYMBOL".
# MINTS=""
# Africa's Talking. AT_USERNAME="sandbox" sends to the simulator only.
AT_USERNAME="sandbox"
AT_API_KEY="atsk_..."
# AT_SENDER_ID=""
USSD_SERVICE_CODE="*384*50549#"
